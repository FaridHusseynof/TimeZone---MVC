@model IEnumerable<Category>
@{
	int count = 1;
}
<div class="row">
	<div class="col-lg-12 grid-margin stretch-card">
		<div class="card">
			<div class="card-body">
				<h4 class="card-title">Category table</h4>
				<a class="btn btn-primary" asp-controller="Category" asp-action="Create">Create Category</a>

				<div class="table-responsive pt-3">
					<table class="table table-dark">
						<thead>
							<tr>
								<th>
									Count
								</th>
								<th>
									Category Name
								</th>
								<th>
									Settings
								</th>
							</tr>
						</thead>

						<tbody>
							@foreach (var category in Model)
							{
								<tr>
									<td>
										@count
									</td>
									<td>
										@category.Name
									</td>
									<td>
										<a class="btn btn-warning" asp-controller="Category" asp-action="Update" asp-route-id="@category.Id"><i class="mdi mdi-table-edit"></i></a>
										<a class="btn btn-danger" asp-controller="Category" asp-action="Delete" asp-route-id="@category.Id"><i class="mdi mdi-delete"></i></a>
									</td>
								</tr>
								count++;
							}
							

		
						</tbody>
					</table>
				</div>
			</div>
		</div>
	</div>
</div>